@model IEnumerable<ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.Proveedor>

@{
    ViewData["Title"] = "Proveedores";
    int i = 0;
}

<div class="card shadow-lg">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-10">
                <h1 class="card-title">
                    <i class="fa-solid fa-truck me-2 text-primary"></i>Listado de Proveedores
                </h1>
            </div>
            <div class="col-md-2">
                <a asp-action="Create" class="btn btn-success w-100">
                    <i class="fa-solid fa-plus"></i> Nuevo
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(TempData["message"]?.ToString()))
        {
            <div class="alert alert-@(TempData["tipo"] ?? "info") alert-dismissible fade show" role="alert">
                @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <table id="tablaProveedor" class="table table-hover table-responsive">
            <thead class="table-dark text-center">
                <tr>
                    <th>#</th>
                    <th>Razón Social</th>
                    <th>RUC</th>
                    <th>Celular</th>
                    <th>Email</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@(++i)</td>
                        <td>@Html.DisplayFor(modelItem => item.RazonSocial)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ruc)</td>
                        <td>@Html.DisplayFor(modelItem => item.Celular)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td class="text-center">
                            @if (User.IsInRole("ADMIN"))
                            {
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    @Html.ActionLink("Editar", "Edit", new { IdProveedor = item.IdProveedor }, new { @class = "btn btn-sm btn-outline-primary", title = "Editar" })
                                    @Html.ActionLink("Eliminar", "Delete", new { IdProveedor = item.IdProveedor }, new { @class = "btn btn-sm btn-outline-danger", title = "Eliminar" })
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaProveedor').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[1, 'asc']],
                responsive: true,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    zeroRecords: "No hay registros",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                }
            });
        });
    </script>
}