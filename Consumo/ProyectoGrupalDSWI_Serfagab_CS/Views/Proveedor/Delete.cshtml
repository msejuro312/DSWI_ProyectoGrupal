@model ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="card shadow-lg">
    <div class="card-body">
        <h1 class="card-title text-center text-danger">
            <i class="fa-solid fa-trash me-2"></i>Eliminar Proveedor
        </h1>
        <h3 class="text-center">¿Estás seguro de eliminar este proveedor?</h3>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdProveedor)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IdProveedor)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RazonSocial)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RazonSocial)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Ruc)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Ruc)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Celular)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Celular)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descripcion)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>
        </dl>

        <form asp-action="Delete" onsubmit="return confirm('¿Está seguro de eliminar este proveedor?');">
            <input type="hidden" asp-for="IdProveedor" />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-dark">
                    <i class="fa-solid fa-reply"></i> Regresar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash"></i> Eliminar
                </button>
            </div>
        </form>
    </div>
</div>