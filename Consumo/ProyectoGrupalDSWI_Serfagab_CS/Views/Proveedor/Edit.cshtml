@model ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="card shadow-lg">
    <div class="card-body">
        <h1 class="card-title text-center">
            <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Editar Proveedor
        </h1>
        <div class="row d-flex justify-content-center">
            <div class="col-md-6">
                <form asp-action="Edit" class="row g-3" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="IdProveedor" />

                    <div class="col-md-6">
                        <label asp-for="RazonSocial" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-building"></i></span>
                            <input asp-for="RazonSocial" class="form-control" placeholder="Razón social" />
                        </div>
                        <span asp-validation-for="RazonSocial" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ruc" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-id-card"></i></span>
                            <input asp-for="Ruc" class="form-control" placeholder="RUC" />
                        </div>
                        <span asp-validation-for="Ruc" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Celular" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                            <input asp-for="Celular" class="form-control" placeholder="Celular" />
                        </div>
                        <span asp-validation-for="Celular" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del proveedor"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-dark">
                            <i class="fa-solid fa-reply"></i> Regresar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}