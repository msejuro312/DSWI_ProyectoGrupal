@model ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.TipoMaterial

@{
    ViewData["Title"] = "Tipo de Material Nuevo";
}

<div class="card shadow-lg">
    <div class="card-body">
        <h1 class="card-title text-center">
            <i class="fa-solid fa-tags me-2 text-primary"></i>Tipo de Material Nuevo
        </h1>
        <div class="row d-flex justify-content-center">
            <div class="col-md-6">
                <form asp-action="Create" class="row g-3" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-md-12">
                        <label asp-for="Nombre" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-tag"></i></span>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre del tipo" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del tipo"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-dark">
                            <i class="fa-solid fa-reply"></i> Regresar
                        </a>
                        <button type="reset" class="btn btn-secondary">
                            <i class="fa-solid fa-broom"></i> Limpiar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Registrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}