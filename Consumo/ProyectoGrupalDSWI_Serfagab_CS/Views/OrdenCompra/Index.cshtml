@model IEnumerable<ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.OrdenCompra>

@{
    ViewData["Title"] = "Órdenes de Compra";
}

<div class="card shadow-lg">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-10">
                <h1 class="card-title">
                    <i class="fa-solid fa-file-lines me-2 text-primary"></i>Consulta de Órdenes de Compra
                </h1>
            </div>
            <div class="col-md-2">
                <a asp-action="Create" class="btn btn-success w-100">
                    <i class="fa-solid fa-plus"></i> Nueva OC
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(TempData["message"]?.ToString()))
        {
            <div class="alert alert-@(TempData["tipo"] ?? "info") alert-dismissible fade show" role="alert">
                @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <table id="tablaOrden" class="table table-hover table-responsive">
            <thead class="table-dark text-center">
                <tr>
                    <th>#</th>
                    <th>Proveedor</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Observaciones</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center"><span class="badge bg-secondary">@item.IdOrdenCompra</span></td>
                        <td>@Html.DisplayFor(modelItem => item.Proveedor)</td>
                        <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(item.Estado switch
                            {
                                "PENDIENTE" => "bg-warning text-dark",
                                "APROBADA" => "bg-info text-dark",
                                "RECIBIDA" => "bg-success",
                                "ANULADA" => "bg-secondary",
                                _ => "bg-secondary"
                            })">@item.Estado</span>
                        </td>
                        <td class="text-end">S/ @item.Total.ToString("N2")</td>
                        <td>@Html.DisplayFor(modelItem => item.Observaciones)</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                @Html.ActionLink("Detalle", "Details", new { IdOrdenCompra = item.IdOrdenCompra }, new { @class = "btn btn-sm btn-outline-info", title = "Ver detalle" })
                                @if (item.Estado == "PENDIENTE" || item.Estado == "APROBADA")
                                {
                                    <form asp-action="Recepcionar" method="post" style="display:inline;">
                                        <input type="hidden" name="IdOrdenCompra" value="@item.IdOrdenCompra" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Recepcionar</button>
                                    </form>
                                }
                                @if (User.IsInRole("ADMIN"))
                                {
                                    @Html.ActionLink("Eliminar", "Delete", new { IdOrdenCompra = item.IdOrdenCompra }, new { @class = "btn btn-sm btn-outline-danger", title = "Eliminar" })
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var tablaOrden = $('#tablaOrden').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[0, 'asc']],
                responsive: true,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    zeroRecords: "No hay registros",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                }
            });
        });
    </script>
}