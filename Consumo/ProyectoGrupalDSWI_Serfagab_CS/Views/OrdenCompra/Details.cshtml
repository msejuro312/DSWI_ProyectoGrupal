@model ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.OrdenCompra

@{
    ViewData["Title"] = "Details";
}

<h1>Detalle de Orden de Compra</h1>

<div>
    <h4>Orden @Html.DisplayFor(model => model.IdOrdenCompra)</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Proveedor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Proveedor)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Fecha)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Fecha)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class="col-sm-10">
            @{
                var badge = Model.Estado switch
                {
                    "PENDIENTE" => "bg-warning text-dark",
                    "APROBADA" => "bg-info text-dark",
                    "RECIBIDA" => "bg-success",
                    "ANULADA" => "bg-secondary",
                    _ => "bg-secondary"
                };
            }
            <span class="badge @badge">@Model.Estado</span>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Observaciones)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Observaciones)
        </dd>
    </dl>
</div>

<h4>Detalles</h4>
<table class="table">
    <thead>
        <tr>
            <th>Material</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Detalles) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Material)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cantidad)
            </td>
            <td>
                S/ @item.PrecioUnitario.ToString("N2")
            </td>
            <td>
                S/ @item.Subtotal.ToString("N2")
            </td>
        </tr>
}
    </tbody>
</table>

<div class="form-group">
    <h4>Total: S/ @Model.Total.ToString("N2")</h4>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>