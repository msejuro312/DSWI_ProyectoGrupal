<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SERFAGAB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/serfagab.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoGrupalDSWI_Serfagab_ConsumoServicios.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        <header class="header">
            <div class="container-fluid d-flex justify-content-between align-items-center py-2">
                <div class="btn-menu">
                    <label for="btn-menu"><i class="fa-solid fa-bars"></i></label>
                </div>
                <div class="text-white text-end">
                    <h1 class="h5 m-0">
                        SERFAGAB - Bienvenido,
                        <span>
                            @User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                            <span class="badge @(User.IsInRole("ADMIN") ? "bg-danger" : "bg-secondary")">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </span>
                        </span>
                    </h1>
                </div>
            </div>
        </header>

        <input type="checkbox" id="btn-menu">

        <div class="container-menu">
            <div class="cont-menu">
                <nav>
                    <a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Inicio</a>
                    <a asp-area="" asp-controller="Proveedor" asp-action="Index"><i class="fa-solid fa-truck"></i> Proveedores</a>
                    <a asp-area="" asp-controller="TipoMaterial" asp-action="Index"><i class="fa-solid fa-tags"></i> Tipo Material</a>
                    <a asp-area="" asp-controller="Material" asp-action="Index"><i class="fa-solid fa-boxes-stacked"></i> Materiales</a>
                    <a asp-area="" asp-controller="OrdenCompra" asp-action="Create"><i class="fa-solid fa-cart-plus"></i> Registrar OC</a>
                    <a asp-area="" asp-controller="OrdenCompra" asp-action="Index"><i class="fa-solid fa-file-lines"></i> Consulta OC</a>
                    <a href="#" id="cerrarSesionLink"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
                </nav>
                <label for="btn-menu"><i class="fa-solid fa-xmark"></i></label>
            </div>
        </div>
    }

    <main>
        <div class="container mt-5 pt-3">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            document.getElementById("cerrarSesionLink").addEventListener("click", function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "¿Deseas cerrar sesión?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Sí, cerrar",
                    cancelButtonText: "No"
                }).then((result) => {
                    if (result.isConfirmed) {
                        var form = document.createElement("form");
                        form.method = "post";
                        form.action = "@Url.Action("Logout", "Login")";
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>