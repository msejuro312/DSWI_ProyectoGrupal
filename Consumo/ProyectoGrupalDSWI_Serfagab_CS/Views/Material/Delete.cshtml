@model ProyectoGrupalDSWI_Serfagab_ConsumoServicios.Models.Material

@{
    ViewData["Title"] = "Eliminar Material";
}

<div class="card shadow-lg">
    <div class="card-body">
        <h1 class="card-title text-center text-danger">
            <i class="fa-solid fa-trash me-2"></i>Eliminar Material
        </h1>
        <h3 class="text-center">¿Estás seguro de eliminar este material?</h3>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdMaterial)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IdMaterial)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TipoMaterial)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TipoMaterial)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UnidadMedida)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UnidadMedida)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StockActual)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.StockActual)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PrecioReferencial)</dt>
            <dd class="col-sm-9">S/ @Model.PrecioReferencial.ToString("N2")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descripcion)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dd>
        </dl>

        <form asp-action="Delete" onsubmit="return confirm('¿Está seguro de eliminar este material?');">
            <input type="hidden" asp-for="IdMaterial" />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-dark">
                    <i class="fa-solid fa-reply"></i> Regresar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash"></i> Eliminar
                </button>
            </div>
        </form>
    </div>
</div>