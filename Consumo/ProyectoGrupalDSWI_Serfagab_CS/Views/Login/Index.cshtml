@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SERFAGAB - Inicio de Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/serfagab.css" asp-append-version="true" />
    <style>
        body { background-image: url('~/css/imagenes/laser.jpg'); }
        .box-login { max-width: 450px; margin: 0 auto; animation: fadeInUp 0.8s ease; }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="box-login">
                <div class="card shadow-lg">
                    <div class="card-header text-center text-white">
                        <h3><i class="fas fa-cubes me-2"></i>SERFAGAB</h3>
                        <small class="opacity-75">Sistema de Gestión de Compras</small>
                    </div>

                    <div class="card-body">
                        <h5 class="text-center mb-4">
                            <i class="fas fa-sign-in-alt me-2 text-dark"></i>Inicio de Sesión
                        </h5>

                        @if (!string.IsNullOrEmpty(TempData["message"]?.ToString()))
                        {
                            <div class="alert alert-@(TempData["tipo"] ?? "danger") alert-dismissible fade show" role="alert">
                                @TempData["message"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="Index" method="post" id="loginForm" novalidate>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i> Login
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                    <input type="text" name="usuario" class="form-control" placeholder="Ingrese su login" required autofocus />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-key me-1"></i> Clave
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                                    <input type="password" name="clave" class="form-control" placeholder="Ingrese su clave" required />
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-dark" id="btnLogin">
                                    <span id="btn-text">
                                        <i class="fas fa-sign-in-alt me-2"></i> INGRESAR
                                    </span>
                                    <span id="btn-spinner" style="display:none;">
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        Ingresando...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-muted text-center">
                        &copy; 2025 SERFAGAB - Todos los derechos reservados
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const form = document.getElementById('loginForm');
            const btn = document.getElementById('btnLogin');
            const textSpan = document.getElementById('btn-text');
            const spinnerSpan = document.getElementById('btn-spinner');

            form.addEventListener('submit', function () {
                textSpan.style.display = 'none';
                spinnerSpan.style.display = 'inline-block';
                btn.disabled = true;
            });
        })();
    </script>
</body>
</html>